"""Type stubs for the ``fsfast._core`` extension module."""

from collections.abc import Awaitable, Sequence
from datetime import datetime
from os import PathLike
from typing import Any

__version__: str

# "raise" | "return" | "omit" (validated at runtime)
_OnError = str
# "overwrite" | "create" | "wb" | "xb" | "ab" (validated at runtime)
_WriteMode = str
_Info = dict[str, Any]
_Buffer = Any  # any object supporting the buffer protocol
_StrPath = str | PathLike[str]

class PreconditionFailed(OSError):
    """A conditional request failed (the object changed under a pinned read,
    or an If-Match / generation precondition was not met)."""

def make_filesystem(protocol: str, options: dict[str, Any] | None = None) -> RustFileSystem: ...
def available_protocols() -> list[str]: ...
def runtime_info() -> dict[str, int]: ...
def _after_fork_child() -> None: ...

