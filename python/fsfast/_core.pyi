    def tell(self) -> int: ...
    def read_ranges(self, ranges: Sequence[tuple[int, int]]) -> list[bytes]: ...
    def clear_cache(self) -> None: ...
    def info(self) -> _Info: ...
    def close(self) -> None: ...

class LineIter:
    def __iter__(self) -> LineIter: ...
    def __next__(self) -> bytes: ...

class RustWriter:
