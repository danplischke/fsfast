    def path(self) -> str: ...
    @property
    def closed(self) -> bool: ...
    @property
    def cache_mode(self) -> str: ...
    def read(self, n: int | None = None) -> bytes: ...
    def readinto(self, buf: _Buffer) -> int: ...
    def readline(self, limit: int | None = None) -> bytes: ...
    def readuntil(self, delim: bytes = b"\n", limit: int | None = None) -> bytes: ...
    def lines(self) -> LineIter: ...
